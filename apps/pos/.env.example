# En desarrollo Vite hace de proxy contra la API; en el servidor del local, la
# aplicación y la API se sirven desde el mismo origen.
VITE_API_BASE_URL=/api

# Las terminales apuntan a un NOMBRE FIJO, nunca a la IP del servidor (P-06):
# al cambiar de equipo, todas las terminales quedarían ciegas.
VITE_API_PROXY=http://127.0.0.1:8000
