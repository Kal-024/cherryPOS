APP_NAME=cherryPOS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# El sistema trabaja en UTC y presenta en la zona de cada sucursal, que vive en
# `cmn_branches.timezone`. Es lo que exige la precondición 4: casa matriz
# consolida locales que pueden no compartir zona, y el consolidado no puede
# depender de que los relojes coincidan.
#
# `DB_TIMEZONE` debe coincidir con `APP_TIMEZONE`: Laravel escribe la marca de
# tiempo como texto sin zona y PostgreSQL la interpreta en la zona de su sesión.
# Si difieren, cada registro queda corrido y nada falla a la vista.
APP_TIMEZONE=UTC
DB_TIMEZONE=UTC
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_NI

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cherrypos
DB_USERNAME=cherrypos
DB_PASSWORD=cherrypos

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── Identidad de la sucursal ────────────────────────────────────────────────
# Una instalación pertenece a una sola sucursal (P-05). No hay multi-tenant.
POS_BRANCH_CODE=001
POS_BRANCH_NAME="Sucursal principal"
POS_IS_HEADQUARTERS=true

# ── Integración con cherryERP ───────────────────────────────────────────────
# Vacío = el POS opera solo y es dueño de todo su dato (P-01). Con ERP, la cola
# de tickets apunta aquí. Nunca bloquea el cierre de una venta (P4).
ERP_BASE_URL=
ERP_TOKEN=
ERP_COMPANY_ID=

# ── Moneda ──────────────────────────────────────────────────────────────────
POS_BASE_CURRENCY=NIO
POS_SECONDARY_CURRENCY=USD
